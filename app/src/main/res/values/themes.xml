<resources>
    <!-- Gun Stairs is deliberately dark-only (see README): a shooting-range/night
         staircase aesthetic reads better than a light theme, and it avoids
         diluting effort across two palettes for a small arcade game. -->
    <style name="Theme.GunStairs" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
